@page "/collections/{id:guid}"
@rendermode InteractiveServer
@attribute [Authorize]
@inject CollectionService CollectionSvc
@inject CardInstanceService CardInstanceSvc
@inject CardService CardSvc
@inject ICurrentUser CurrentUser
@inject IUserLookup UserLookup
@inject NavigationManager Nav

<PageTitle>@(_collection?.Name ?? "Collection")</PageTitle>

@if (_loading)
{
    <p class="text-muted">Loading…</p>
}
else if (_collection is null)
{
    <p class="text-danger">Collection not found.</p>
    <a href="/collections" class="btn btn-secondary btn-sm">Back to Collections</a>
}
else
{
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/collections">Collections</a></li>
            <li class="breadcrumb-item active">@_collection.Name</li>
        </ol>
    </nav>

    <h1 class="mb-4">@_collection.Name</h1>

    @if (_error is not null)
    {
        <div class="alert alert-danger alert-dismissible">
            @_error
            <button type="button" class="btn-close" @onclick="() => _error = null"></button>
        </div>
    }
    @if (_success is not null)
    {
        <div class="alert alert-success alert-dismissible">
            @_success
            <button type="button" class="btn-close" @onclick="() => _success = null"></button>
        </div>
    }

    <div class="row g-4 mb-4">
        <div class="col-md-6">
            <div class="card h-100">
                <div class="card-header">Visibility</div>
                <div class="card-body">
                    <p class="card-text text-muted small">
                        Public collections can be viewed by anyone. Private collections are
                        visible only to you and the people you share them with.
                    </p>
                    <div class="d-flex gap-2">
                        <button class="btn btn-outline-primary" @onclick="MakePublicAsync">Make Public</button>
                        <button class="btn btn-outline-secondary" @onclick="MakePrivateAsync">Make Private</button>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card h-100">
                <div class="card-header">Share with a user</div>
                <div class="card-body">
                    <p class="card-text text-muted small">
                        Enter the email address of the user you want to share this collection with.
                        They will be able to view the collection and its card instances.
                    </p>
                    <div class="input-group mb-2">
                        <input class="form-control"
                               type="email"
                               placeholder="user@example.com"
                               @bind="_shareEmail"
                               @bind:event="oninput"
                               @onkeydown="OnShareKeyDown" />
                        <button class="btn btn-primary"
                                @onclick="ShareAsync"
                                disabled="@(string.IsNullOrWhiteSpace(_shareEmail) || _saving)">
                            Share
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card h-100">
                <div class="card-header">Revoke access</div>
                <div class="card-body">
                    <p class="card-text text-muted small">
                        Remove view access from a previously shared user.
                    </p>
                    <div class="input-group mb-2">
                        <input class="form-control"
                               type="email"
                               placeholder="user@example.com"
                               @bind="_unshareEmail"
                               @bind:event="oninput"
                               @onkeydown="OnUnshareKeyDown" />
                        <button class="btn btn-outline-danger"
                                @onclick="UnshareAsync"
                                disabled="@(string.IsNullOrWhiteSpace(_unshareEmail) || _saving)">
                            Revoke
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-12">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <span>Card Instances</span>
                    <span class="badge bg-secondary">@_instances.Count</span>
                </div>
                <div class="card-body p-0">
                    @if (_instances.Count == 0)
                    {
                        <p class="text-muted p-3 mb-0">No instances in this collection yet.</p>
                    }
                    else
                    {
                        <table class="table table-hover mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Card</th>
                                    <th>Player</th>
                                    <th>Set</th>
                                    <th>Print #</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var inst in _instances)
                                {
                                    var card = _cardLookup.GetValueOrDefault(inst.CardId);
                                    <tr>
                                        <td>@(card?.Name ?? "—")</td>
                                        <td>@(card?.PlayerName ?? "—")</td>
                                        <td>@(card?.SetName ?? "—")</td>
                                        <td>@inst.PrintNumber / @(card?.PrintRun.ToString() ?? "?")</td>
                                        <td class="text-end">
                                            <button class="btn btn-outline-danger btn-sm"
                                                    @onclick="() => RemoveInstanceAsync(inst.Id)"
                                                    disabled="@_saving">
                                                Remove
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                </div>
            </div>
        </div>

        <div class="col-12">
            <div class="card">
                <div class="card-header">Mint New Instance</div>
                <div class="card-body">
                    @if (_availableCards.Count == 0)
                    {
                        <p class="text-muted mb-0">No cards in the catalog yet.</p>
                    }
                    else
                    {
                        <div class="row g-3 align-items-end">
                            <div class="col-md-5">
                                <label class="form-label small text-muted">Card</label>
                                <select class="form-select" @bind="_mintCardId">
                                    <option value="">— select a card —</option>
                                    @foreach (var c in _availableCards)
                                    {
                                        <option value="@c.Id.Value">@c.Name (@c.SetName, @c.Rarity)</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-3">
                                <label class="form-label small text-muted">Print Number</label>
                                <input class="form-control"
                                       type="number"
                                       min="1"
                                       placeholder="e.g. 42"
                                       @bind="_mintPrintNumber"
                                       @bind:event="oninput" />
                            </div>
                            <div class="col-md-auto">
                                <button class="btn btn-primary"
                                        @onclick="MintAsync"
                                        disabled="@(!CanMint || _saving)">
                                    Mint &amp; Add
                                </button>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public Guid Id { get; set; }

    private Collection? _collection;
    private bool _loading = true;
    private string? _error;
    private string? _success;
    private bool _saving;

    // Sharing
    private string _shareEmail = "";
    private string _unshareEmail = "";

    // Instances
    private IReadOnlyList<CardInstance> _instances = [];
    private Dictionary<CardId, Card> _cardLookup = [];
    private IReadOnlyList<Card> _availableCards = [];

    // Mint form
    private string _mintCardId = "";
    private int? _mintPrintNumber;
    private bool CanMint => !string.IsNullOrEmpty(_mintCardId) && _mintPrintNumber is >= 1;

    protected override async Task OnParametersSetAsync()
    {
        _loading = true;
        try
        {
            _collection = await CollectionSvc.GetByIdAsync(new CollectionId(Id));
            if (_collection is not null)
                await LoadInstancesAndCardsAsync();
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _loading = false; }
    }

    private async Task LoadInstancesAndCardsAsync()
    {
        _instances = await CardInstanceSvc.GetByCollectionAsync(new CollectionId(Id));
        _availableCards = await CardSvc.GetAllAsync();
        _cardLookup = _availableCards.ToDictionary(c => c.Id);
    }

    private async Task MintAsync()
    {
        if (!CanMint) return;
        _error = null; _success = null; _saving = true;
        try
        {
            var userId = await CurrentUser.GetUserIdAsync();
            var cardId = new CardId(Guid.Parse(_mintCardId));
            await CardInstanceSvc.MintAndAddToCollectionAsync(
                CardInstanceId.New(), cardId, userId, _mintPrintNumber!.Value, new CollectionId(Id));
            _mintCardId = "";
            _mintPrintNumber = null;
            _success = "Instance minted and added to collection.";
            await LoadInstancesAndCardsAsync();
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _saving = false; }
    }

    private async Task RemoveInstanceAsync(CardInstanceId instanceId)
    {
        _error = null; _success = null; _saving = true;
        try
        {
            var userId = await CurrentUser.GetUserIdAsync();
            await CardInstanceSvc.RemoveFromCollectionAsync(instanceId, userId, new CollectionId(Id));
            _success = "Instance removed from collection.";
            await LoadInstancesAndCardsAsync();
        }
        catch (UnauthorizedAccessException) { _error = "You don't have permission to remove this instance."; }
        catch (Exception ex) { _error = ex.Message; }
        finally { _saving = false; }
    }

    private async Task MakePublicAsync()
    {
        _error = null; _success = null;
        try
        {
            var userId = await CurrentUser.GetUserIdAsync();
            await CollectionSvc.MakePublicAsync(new CollectionId(Id), userId);
            _success = "Collection is now public — anyone can view it.";
        }
        catch (UnauthorizedAccessException) { _error = "You don't have permission to change this collection."; }
        catch (Exception ex) { _error = ex.Message; }
    }

    private async Task MakePrivateAsync()
    {
        _error = null; _success = null;
        try
        {
            var userId = await CurrentUser.GetUserIdAsync();
            await CollectionSvc.MakePrivateAsync(new CollectionId(Id), userId);
            _success = "Collection is now private.";
        }
        catch (UnauthorizedAccessException) { _error = "You don't have permission to change this collection."; }
        catch (Exception ex) { _error = ex.Message; }
    }

    private async Task OnShareKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await ShareAsync();
    }

    private async Task ShareAsync()
    {
        if (string.IsNullOrWhiteSpace(_shareEmail)) return;
        _error = null; _success = null; _saving = true;
        try
        {
            var targetId = await UserLookup.FindByEmailAsync(_shareEmail.Trim());
            if (targetId is null) { _error = $"No account found for '{_shareEmail.Trim()}'."; return; }

            var userId = await CurrentUser.GetUserIdAsync();
            await CollectionSvc.ShareWithUserAsync(new CollectionId(Id), userId, targetId.Value);
            _shareEmail = "";
            _success = "Access granted.";
        }
        catch (UnauthorizedAccessException) { _error = "You don't have permission to share this collection."; }
        catch (Exception ex) { _error = ex.Message; }
        finally { _saving = false; }
    }

    private async Task OnUnshareKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await UnshareAsync();
    }

    private async Task UnshareAsync()
    {
        if (string.IsNullOrWhiteSpace(_unshareEmail)) return;
        _error = null; _success = null; _saving = true;
        try
        {
            var targetId = await UserLookup.FindByEmailAsync(_unshareEmail.Trim());
            if (targetId is null) { _error = $"No account found for '{_unshareEmail.Trim()}'."; return; }

            var userId = await CurrentUser.GetUserIdAsync();
            await CollectionSvc.UnshareAsync(new CollectionId(Id), userId, targetId.Value);
            _unshareEmail = "";
            _success = "Access revoked.";
        }
        catch (UnauthorizedAccessException) { _error = "You don't have permission to change this collection."; }
        catch (Exception ex) { _error = ex.Message; }
        finally { _saving = false; }
    }
}

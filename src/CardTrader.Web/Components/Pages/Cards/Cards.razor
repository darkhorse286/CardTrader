@page "/cards"
@rendermode InteractiveServer
@attribute [Authorize]
@inject CardService CardSvc
@inject CardInstanceService CardInstanceSvc
@inject ICurrentUser CurrentUser

<PageTitle>Card Catalogue</PageTitle>

<h1 class="mb-4">Card Catalogue</h1>

@if (_loading)
{
    <p class="text-muted">Loading…</p>
}
else
{
    <!-- My Instances -->
    @if (_ownedInstances.Count > 0)
    {
        <div class="card mb-4">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span class="fw-semibold">My Card Instances</span>
                <span class="badge bg-secondary">@_ownedInstances.Count</span>
            </div>
            <div class="card-body p-0">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Player</th>
                            <th>Position</th>
                            <th>Rarity</th>
                            <th>Print #</th>
                            <th>Roster</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var inst in _ownedInstances)
                        {
                            var card = _cardLookup.GetValueOrDefault(inst.CardId);
                            <tr>
                                <td>@(card?.PlayerName ?? "—")</td>
                                <td>
                                    @if (card?.PlayerPosition is { } pos)
                                    {
                                        <span class="badge @PositionClass(pos)">@pos</span>
                                    }
                                </td>
                                <td>
                                    @if (card?.Rarity is { } r)
                                    {
                                        <span class="badge @RarityClass(r)">@r</span>
                                    }
                                </td>
                                <td>@inst.PrintNumber / @(card?.PrintRun.ToString("N0") ?? "?")</td>
                                <td>
                                    @if (inst.RosterId is { } rid)
                                    {
                                        <a href="/rosters/@rid.Value">on roster</a>
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

    <!-- Catalogue -->
    <div class="d-flex gap-2 mb-3 flex-wrap">
        @foreach (var pos in new[] { "", "Attack", "Midfield", "Defense", "Goalie" })
        {
            <button class="btn btn-sm @(pos == _filter ? "btn-primary" : "btn-outline-secondary")"
                    @onclick="() => _filter = pos">
                @(pos == "" ? "All" : pos)
                <span class="badge @(pos == _filter ? "bg-light text-dark" : "bg-secondary") ms-1">
                    @(pos == "" ? _cards.Count : _cards.Count(c => c.PlayerPosition == pos))
                </span>
            </button>
        }
    </div>

    @if (FilteredCards.Count == 0)
    {
        <div class="alert alert-info">No cards in the catalogue yet. Start the application to seed demo cards.</div>
    }
    else
    {
        <div class="ct-cards-grid">
            @foreach (var card in FilteredCards.OrderBy(c => RarityOrder(c.Rarity)).ThenBy(c => c.PlayerName))
            {
                var css = RarityCssClass(card.Rarity);
                <div class="ct-card @css">
                    <div class="ct-card-header">
                        <span class="ct-set-name" title="@card.SetName">@card.SetName</span>
                        <span class="ct-rarity-pill">@card.Rarity</span>
                    </div>
                    @if (card.ImageUrl is { } url)
                    {
                        <img class="ct-card-art" src="@url" alt="@card.PlayerName" />
                    }
                    else
                    {
                        <div class="ct-card-art"></div>
                    }
                    <div class="ct-card-body">
                        <p class="ct-player-name" title="@card.PlayerName">@card.PlayerName</p>
                        <p class="ct-player-meta">@(card.PlayerPosition ?? "—") · @(card.TeamName ?? "—")</p>
                    </div>
                    <div class="ct-card-footer">
                        <span class="ct-footer-label">CardTrader</span>
                        <span class="ct-footer-run">/@card.PrintRun.ToString("N0")</span>
                    </div>
                </div>
            }
        </div>
    }
}

@code {
    private bool _loading = true;
    private IReadOnlyList<Card> _cards = [];
    private IReadOnlyList<CardInstance> _ownedInstances = [];
    private Dictionary<CardId, Card> _cardLookup = [];
    private string _filter = "";

    private IReadOnlyList<Card> FilteredCards =>
        string.IsNullOrEmpty(_filter)
            ? _cards
            : _cards.Where(c => c.PlayerPosition == _filter).ToList();

    protected override async Task OnInitializedAsync()
    {
        _cards = await CardSvc.GetAllAsync();
        _cardLookup = _cards.ToDictionary(c => c.Id);
        try
        {
            var userId = await CurrentUser.GetUserIdAsync();
            _ownedInstances = await CardInstanceSvc.GetOwnedAsync(userId);
        }
        catch { /* unauthenticated — instances stay empty */ }
        _loading = false;
    }

    private static string PositionClass(string pos) => pos switch
    {
        "Attack"   => "bg-danger",
        "Midfield" => "bg-warning text-dark",
        "Defense"  => "bg-primary",
        "Goalie"   => "bg-success",
        _          => "bg-secondary",
    };

    private static string RarityClass(string rarity) => rarity switch
    {
        "Legendary"  => "bg-warning text-dark",
        "Ultra Rare" => "bg-danger",
        "Rare"       => "bg-primary",
        "Uncommon"   => "bg-info text-dark",
        _            => "bg-secondary",
    };

    private static string RarityCssClass(string rarity) => rarity switch
    {
        "Legendary"  => "legendary",
        "Ultra Rare" => "ultra-rare",
        "Rare"       => "rare",
        "Uncommon"   => "uncommon",
        _            => "common",
    };

    private static int RarityOrder(string rarity) => rarity switch
    {
        "Legendary"  => 0,
        "Ultra Rare" => 1,
        "Rare"       => 2,
        "Uncommon"   => 3,
        _            => 4,
    };
}

@page "/rosters/{id:guid}"
@rendermode InteractiveServer
@attribute [Authorize]
@inject RosterService RosterSvc
@inject CardInstanceService CardInstanceSvc
@inject CardService CardSvc
@inject ICurrentUser CurrentUser
@inject IUserLookup UserLookup
@inject NavigationManager Nav

<PageTitle>@(_roster?.Name ?? "Roster")</PageTitle>

@if (_loading)
{
    <p class="text-muted">Loading…</p>
}
else if (_roster is null)
{
    <p class="text-danger">Roster not found.</p>
    <a href="/rosters" class="btn btn-secondary btn-sm">Back to Rosters</a>
}
else if (!_canView)
{
    <div class="alert alert-danger">You do not have permission to view this roster.</div>
    <a href="/rosters" class="btn btn-secondary btn-sm">Back to Rosters</a>
}
else
{
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/rosters">Rosters</a></li>
            <li class="breadcrumb-item active">@_roster.Name</li>
        </ol>
    </nav>

    <h1 class="mb-4">@_roster.Name</h1>

    @if (_error is not null)
    {
        <div class="alert alert-danger alert-dismissible">
            @_error
            <button type="button" class="btn-close" @onclick="() => _error = null"></button>
        </div>
    }
    @if (_success is not null)
    {
        <div class="alert alert-success alert-dismissible">
            @_success
            <button type="button" class="btn-close" @onclick="() => _success = null"></button>
        </div>
    }

    @if (_canManage)
    {
    <div class="row g-4 mb-4">
        <div class="col-md-6">
            <div class="card h-100">
                <div class="card-header">Visibility</div>
                <div class="card-body">
                    <p class="card-text text-muted small">
                        Public rosters can be viewed by anyone. Private rosters are
                        visible only to you and the people you share them with.
                    </p>
                    <div class="d-flex gap-2">
                        <button class="btn btn-outline-primary" @onclick="MakePublicAsync">Make Public</button>
                        <button class="btn btn-outline-secondary" @onclick="MakePrivateAsync">Make Private</button>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card h-100">
                <div class="card-header">Share with a user</div>
                <div class="card-body">
                    <p class="card-text text-muted small">
                        Enter the email address of the user you want to share this roster with.
                    </p>
                    <div class="input-group mb-2">
                        <input class="form-control"
                               type="email"
                               placeholder="user@example.com"
                               @bind="_shareEmail"
                               @bind:event="oninput"
                               @onkeydown="OnShareKeyDown" />
                        <button class="btn btn-primary"
                                @onclick="ShareAsync"
                                disabled="@(string.IsNullOrWhiteSpace(_shareEmail) || _saving)">
                            Share
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card h-100">
                <div class="card-header">Revoke access</div>
                <div class="card-body">
                    <p class="card-text text-muted small">
                        Remove view access from a previously shared user.
                    </p>
                    <div class="input-group mb-2">
                        <input class="form-control"
                               type="email"
                               placeholder="user@example.com"
                               @bind="_unshareEmail"
                               @bind:event="oninput"
                               @onkeydown="OnUnshareKeyDown" />
                        <button class="btn btn-outline-danger"
                                @onclick="UnshareAsync"
                                disabled="@(string.IsNullOrWhiteSpace(_unshareEmail) || _saving)">
                            Revoke
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card h-100">
                <div class="card-header">Roster Slots (@_instances.Count / @RosterConstraints.MaxSize)</div>
                <div class="card-body">
                    <table class="table table-sm mb-0">
                        <tbody>
                            @foreach (var (pos, max) in RosterConstraints.PositionSlots)
                            {
                                var current = PositionCount(pos);
                                <tr>
                                    <td class="fw-semibold">@pos</td>
                                    <td>@current / @max</td>
                                    <td>
                                        @for (int i = 0; i < max; i++)
                                        {
                                            <span class="me-1 @(i < current ? "text-success" : "text-secondary")">●</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    }

    <div class="row g-4">
        <div class="col-12">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <span>Players</span>
                    <span class="badge bg-secondary">@_instances.Count</span>
                </div>
                <div class="card-body p-0">
                    @if (_instances.Count == 0)
                    {
                        <p class="text-muted p-3 mb-0">No players on this roster yet.</p>
                    }
                    else
                    {
                        <table class="table table-hover mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Player</th>
                                    <th>Position</th>
                                    <th>Set</th>
                                    <th>Print #</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var inst in _instances)
                                {
                                    var card = _cardLookup.GetValueOrDefault(inst.CardId);
                                    <tr>
                                        <td>@(card?.Name ?? "—")</td>
                                        <td>
                                            @if (card?.PlayerPosition is { } pos)
                                            {
                                                <span class="badge bg-info text-dark">@pos</span>
                                            }
                                            else
                                            {
                                                <span class="text-muted">—</span>
                                            }
                                        </td>
                                        <td>@(card?.SetName ?? "—")</td>
                                        <td>@inst.PrintNumber / @(card?.PrintRun.ToString() ?? "?")</td>
                                        <td class="text-end">
                                            @if (_canManage)
                                            {
                                                <button class="btn btn-outline-danger btn-sm"
                                                        @onclick="() => RemovePlayerAsync(inst.Id)"
                                                        disabled="@_saving">
                                                    Remove
                                                </button>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                </div>
            </div>
        </div>

        @if (_canManage)
        {
        <div class="col-12">
            <div class="card">
                <div class="card-header">Add from Collection</div>
                <div class="card-body">
                    @if (_instances.Count >= RosterConstraints.MaxSize)
                    {
                        <p class="text-muted mb-0">Roster is full (@RosterConstraints.MaxSize/@RosterConstraints.MaxSize players).</p>
                    }
                    else if (AddableInstances.Count == 0)
                    {
                        <p class="text-muted mb-0">
                            No unrostered cards in your collection fit this roster's open slots.
                        </p>
                    }
                    else
                    {
                        <div class="row g-3 align-items-end">
                            <div class="col-md-6">
                                <label class="form-label small text-muted">Your card</label>
                                <select class="form-select" @bind="_addInstanceId">
                                    <option value="">— select a card —</option>
                                    @foreach (var inst in AddableInstances)
                                    {
                                        var card = _cardLookup.GetValueOrDefault(inst.CardId);
                                        <option value="@inst.Id.Value">
                                            @(card?.PlayerName ?? "—")
                                            (@(card?.Rarity ?? "?"), #@inst.PrintNumber / @(card?.PrintRun ?? 0))
                                        </option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-auto">
                                <button class="btn btn-outline-primary"
                                        @onclick="AddFromCollectionAsync"
                                        disabled="@(string.IsNullOrEmpty(_addInstanceId) || _saving)">
                                    Add to Roster
                                </button>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="col-12">
            <div class="card">
                <div class="card-header">Mint New Card</div>
                <div class="card-body">
                    @if (_availableCards.Count == 0)
                    {
                        <p class="text-muted mb-0">No cards in the catalog yet.</p>
                    }
                    else if (_instances.Count >= RosterConstraints.MaxSize)
                    {
                        <p class="text-muted mb-0">Roster is full (10/10 players).</p>
                    }
                    else
                    {
                        <div class="row g-3 align-items-end">
                            <div class="col-md-5">
                                <label class="form-label small text-muted">Card</label>
                                <select class="form-select" @bind="_mintCardId">
                                    <option value="">— select a card —</option>
                                    @foreach (var c in MintableCards)
                                    {
                                        <option value="@c.Id.Value">
                                            @c.Name (@c.PlayerPosition, @c.SetName, @c.Rarity)
                                        </option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-3">
                                <label class="form-label small text-muted">Print Number</label>
                                <input class="form-control"
                                       type="number"
                                       min="1"
                                       max="@(SelectedCard?.PrintRun)"
                                       placeholder="e.g. 42"
                                       @bind="_mintPrintNumber"
                                       @bind:event="oninput" />
                            </div>
                            <div class="col-md-auto">
                                <button class="btn btn-primary"
                                        @onclick="MintAsync"
                                        disabled="@(!CanMint || _saving)">
                                    Mint &amp; Add
                                </button>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
        }
    </div>
}

@code {
    [Parameter] public Guid Id { get; set; }

    private Roster? _roster;
    private bool _loading = true;
    private bool _canView;
    private bool _canManage;
    private string? _error;
    private string? _success;
    private bool _saving;

    private string _shareEmail = "";
    private string _unshareEmail = "";

    private IReadOnlyList<CardInstance> _instances = [];
    private IReadOnlyList<CardInstance> _unrosteredInstances = [];
    private Dictionary<CardId, Card> _cardLookup = [];
    private IReadOnlyList<Card> _availableCards = [];
    private UserId _userId;

    private string _mintCardId = "";
    private int? _mintPrintNumber;
    private string _addInstanceId = "";

    private Card? SelectedCard =>
        string.IsNullOrEmpty(_mintCardId) ? null
        : _availableCards.FirstOrDefault(c => c.Id.Value == Guid.Parse(_mintCardId));

    private bool CanMint =>
        SelectedCard is { } card &&
        _mintPrintNumber is >= 1 &&
        _mintPrintNumber <= card.PrintRun;

    private int PositionCount(string position) =>
        _instances.Count(i => _cardLookup.GetValueOrDefault(i.CardId)?.PlayerPosition == position);

    private IReadOnlyList<Card> MintableCards => _availableCards
        .Where(c =>
        {
            if (c.PlayerPosition is null) return true;
            if (!RosterConstraints.PositionSlots.TryGetValue(c.PlayerPosition, out var max)) return true;
            return PositionCount(c.PlayerPosition) < max;
        })
        .ToList();

    // Unrostered instances the current user owns that fit the roster's open position slots
    private IReadOnlyList<CardInstance> AddableInstances => _unrosteredInstances
        .Where(inst =>
        {
            var card = _cardLookup.GetValueOrDefault(inst.CardId);
            if (card?.PlayerPosition is not { } pos) return true;
            if (!RosterConstraints.PositionSlots.TryGetValue(pos, out var max)) return true;
            return PositionCount(pos) < max;
        })
        .ToList();

    protected override async Task OnParametersSetAsync()
    {
        _loading = true;
        _canView = false;
        _canManage = false;
        try
        {
            _roster = await RosterSvc.GetByIdAsync(new RosterId(Id));
            if (_roster is not null)
            {
                _userId = await CurrentUser.GetUserIdAsync();
                var rid = new RosterId(Id);
                _canManage = await RosterSvc.CanManageAsync(rid, _userId);
                _canView = _canManage || await RosterSvc.CanViewAsync(rid, _userId);
                if (_canView)
                    await LoadPlayersAndCardsAsync();
            }
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _loading = false; }
    }

    private async Task LoadPlayersAndCardsAsync()
    {
        _instances = await CardInstanceSvc.GetByRosterAsync(new RosterId(Id));
        _availableCards = await CardSvc.GetAllAsync();
        _cardLookup = _availableCards.ToDictionary(c => c.Id);
        if (_canManage)
        {
            var owned = await CardInstanceSvc.GetOwnedAsync(_userId);
            _unrosteredInstances = owned.Where(i => i.RosterId is null).ToList();
        }
    }

    private async Task MintAsync()
    {
        if (!CanMint) return;
        _error = null; _success = null; _saving = true;
        try
        {
            var cardId = new CardId(Guid.Parse(_mintCardId));
            await CardInstanceSvc.MintAndAddToRosterAsync(
                CardInstanceId.New(), cardId, _userId, _mintPrintNumber!.Value, new RosterId(Id));
            _mintCardId = "";
            _mintPrintNumber = null;
            _success = "Player card minted and added to roster.";
            await LoadPlayersAndCardsAsync();
        }
        catch (InvalidOperationException ex) { _error = ex.Message; }
        catch (ArgumentOutOfRangeException) { _error = "Print number is outside the valid range for this card."; }
        catch (KeyNotFoundException) { _error = "Card not found. Please refresh and try again."; }
        catch (Exception ex) { _error = ex.Message; }
        finally { _saving = false; }
    }

    private async Task AddFromCollectionAsync()
    {
        if (string.IsNullOrEmpty(_addInstanceId)) return;
        _error = null; _success = null; _saving = true;
        try
        {
            var instanceId = new CardInstanceId(Guid.Parse(_addInstanceId));
            await CardInstanceSvc.AddToRosterAsync(instanceId, _userId, new RosterId(Id));
            _addInstanceId = "";
            _success = "Card added to roster.";
            await LoadPlayersAndCardsAsync();
        }
        catch (InvalidOperationException ex) { _error = ex.Message; }
        catch (UnauthorizedAccessException) { _error = "You don't have permission to add this card."; }
        catch (Exception ex) { _error = ex.Message; }
        finally { _saving = false; }
    }

    private async Task RemovePlayerAsync(CardInstanceId instanceId)
    {
        _error = null; _success = null; _saving = true;
        try
        {
            await CardInstanceSvc.RemoveFromRosterAsync(instanceId, _userId, new RosterId(Id));
            _success = "Player removed from roster.";
            await LoadPlayersAndCardsAsync();
        }
        catch (UnauthorizedAccessException) { _error = "You don't have permission to remove this player."; }
        catch (Exception ex) { _error = ex.Message; }
        finally { _saving = false; }
    }

    private async Task MakePublicAsync()
    {
        _error = null; _success = null;
        try
        {
            await RosterSvc.MakePublicAsync(new RosterId(Id), _userId);
            _success = "Roster is now public — anyone can view it.";
        }
        catch (UnauthorizedAccessException) { _error = "You don't have permission to change this roster."; }
        catch (Exception ex) { _error = ex.Message; }
    }

    private async Task MakePrivateAsync()
    {
        _error = null; _success = null;
        try
        {
            await RosterSvc.MakePrivateAsync(new RosterId(Id), _userId);
            _success = "Roster is now private.";
        }
        catch (UnauthorizedAccessException) { _error = "You don't have permission to change this roster."; }
        catch (Exception ex) { _error = ex.Message; }
    }

    private async Task OnShareKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await ShareAsync();
    }

    private async Task ShareAsync()
    {
        if (string.IsNullOrWhiteSpace(_shareEmail)) return;
        _error = null; _success = null; _saving = true;
        try
        {
            var targetId = await UserLookup.FindByEmailAsync(_shareEmail.Trim());
            if (targetId is null) { _error = $"No account found for '{_shareEmail.Trim()}'."; return; }
            await RosterSvc.ShareWithUserAsync(new RosterId(Id), _userId, targetId.Value);
            _shareEmail = "";
            _success = "Access granted.";
        }
        catch (UnauthorizedAccessException) { _error = "You don't have permission to share this roster."; }
        catch (Exception ex) { _error = ex.Message; }
        finally { _saving = false; }
    }

    private async Task OnUnshareKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await UnshareAsync();
    }

    private async Task UnshareAsync()
    {
        if (string.IsNullOrWhiteSpace(_unshareEmail)) return;
        _error = null; _success = null; _saving = true;
        try
        {
            var targetId = await UserLookup.FindByEmailAsync(_unshareEmail.Trim());
            if (targetId is null) { _error = $"No account found for '{_unshareEmail.Trim()}'."; return; }
            await RosterSvc.UnshareAsync(new RosterId(Id), _userId, targetId.Value);
            _unshareEmail = "";
            _success = "Access revoked.";
        }
        catch (UnauthorizedAccessException) { _error = "You don't have permission to change this roster."; }
        catch (Exception ex) { _error = ex.Message; }
        finally { _saving = false; }
    }
}
